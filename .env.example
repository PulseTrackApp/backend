# Variables attendues par docker-compose.prod.yaml.
#
# A recopier dans l'interface de Coolify (onglet « Environment Variables ») ou
# dans un `.env` local pour un essai avec `docker compose -f docker-compose.prod.yaml up`.
# Le vrai `.env` n'est jamais committe : seul ce modele l'est.

# --- Base de donnees -------------------------------------------------------
POSTGRES_DB=pulsetrack
POSTGRES_USER=pulsetrack
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Securite --------------------------------------------------------------
# 32 caracteres minimum (impose par HS256), sinon l'application refuse de
# demarrer. openssl rand -base64 48
PULSETRACK_JWT_SECRET=

# Chiffre les cles API Gemini au repos. Changer ce couple rend illisibles
# celles deja stockees : les utilisateurs devront les ressaisir.
# openssl rand -base64 32
PULSETRACK_ENCRYPTION_PASSWORD=
# Hexadecimal uniquement. openssl rand -hex 8
PULSETRACK_ENCRYPTION_SALT=

# FACULTATIF. Origines autorisees pour un client navigateur, separees par des
# virgules. A laisser vide sur un projet mobile : une application native
# n'envoie pas d'en-tete Origin et n'est jamais soumise au CORS.
# A renseigner le jour ou un front web appellera l'API. Jamais `*`, ce qui
# reviendrait a laisser n'importe quelle page du web lire les reponses.
PULSETRACK_CORS_ORIGINS=

# --- Assistant IA (optionnel) ----------------------------------------------
# Laissee vide, l'assistant retombe sur la cle saisie par l'utilisateur.
PULSETRACK_GEMINI_API_KEY=

# --- Notifications push (optionnel) ----------------------------------------
# A laisser `false` tant que l'application mobile n'enregistre pas ses jetons
# d'appareil : sans destinataire, activer FCM n'envoie rien.
PULSETRACK_FCM_ENABLED=false

# ID du projet Firebase (pas son numero, pas votre domaine) : le champ
# `project_id` du JSON de compte de service.
PULSETRACK_FCM_PROJECT_ID=

# Emplacement du compte de service DANS LE CONTENEUR. Inutile d'y toucher : la
# valeur par defaut du compose correspond deja au point de montage declare.
# Le prefixe `file:` est obligatoire, sans lui la ressource est cherchee dans
# le classpath et le demarrage echoue.
#
# Le fichier lui-meme ne se met pas ici : il est fourni par Coolify (service
# `app`, onglet Storages, montage de type fichier) avec pour destination
# /app/secrets/firebase-service-account.json.
PULSETRACK_FCM_CREDENTIALS=file:/app/secrets/firebase-service-account.json
