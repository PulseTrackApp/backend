# Variables attendues par docker-compose.prod.yaml.
#
# A recopier dans l'interface de Coolify (onglet « Environment Variables ») ou
# dans un `.env` local pour un essai avec `docker compose -f docker-compose.prod.yaml up`.
# Le vrai `.env` n'est jamais committe : seul ce modele l'est.

# --- Base de donnees -------------------------------------------------------
POSTGRES_DB=pulsetrack
POSTGRES_USER=pulsetrack
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Securite --------------------------------------------------------------
# 32 caracteres minimum (impose par HS256), sinon l'application refuse de
# demarrer. openssl rand -base64 48
PULSETRACK_JWT_SECRET=

# Chiffre les cles API Gemini au repos. Changer ce couple rend illisibles
# celles deja stockees : les utilisateurs devront les ressaisir.
# openssl rand -base64 32
PULSETRACK_ENCRYPTION_PASSWORD=
# Hexadecimal uniquement. openssl rand -hex 8
PULSETRACK_ENCRYPTION_SALT=

# Origines autorisees pour un client web, separees par des virgules.
# Jamais `*` : les requetes portent un en-tete Authorization.
PULSETRACK_CORS_ORIGINS=https://pulsetrack.example.com

# --- Assistant IA (optionnel) ----------------------------------------------
# Laissee vide, l'assistant retombe sur la cle saisie par l'utilisateur.
PULSETRACK_GEMINI_API_KEY=

# --- Notifications push (optionnel) ----------------------------------------
PULSETRACK_FCM_ENABLED=false
PULSETRACK_FCM_PROJECT_ID=
# Chemin, dans le conteneur, du JSON de compte de service Firebase.
PULSETRACK_FCM_CREDENTIALS=
